<?xml version="1.0"?>
<ruleset name="WordPress Coding Standards for Plugins">
	<!-- Setting textdomain. -->
	<config name="text_domain" value="sureforms"/>
	<!-- Setting prefix. -->
	<config name="prefixes" value=""/>
	<!-- WP version. -->
	<config name="minimum_wp_version" value="5.2"/>
	<description>Generally-applicable sniffs for WordPress plugins</description>

	<!-- Check all PHP files in directory tree by default. -->
	<file>.</file>

  <!--
  Prevent errors caused by WordPress Coding Standards not supporting PHP 8.0+.
  See https://github.com/WordPress/WordPress-Coding-Standards/issues/2035
  -->
  <ini name="error_reporting" value="E_ALL &#38; ~E_DEPRECATED" />


	<!-- PHP 7.4 and higher. -->
    <config name="testVersion" value="7.4-"/>
	<!-- Arguments - extension, parallel, colors, show porgress, Show sniff codes in all reports -->
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="20"/>
	<arg name="colors"/>
    <arg value="sp"/>
	<arg value="s"/>

	<!-- Rules -->
	<rule ref="WordPress-Extra" />
	<!-- <rule ref="WordPress-VIP-Go"/> -->
	<rule ref="PHPCompatibilityWP"/>
  <exclude name="Generic.Commenting.Todo.TaskFound" />
 	 <rule ref="WordPress-Core">
	    <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
    </rule>

     <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName" />
    </rule>
	<rule ref="WordPress-Docs" />

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="sureforms"/>
			</property>
		</properties>
	</rule>

	<rule ref="Universal.Arrays.DisallowShortArraySyntax.Found">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.Arrays.DisallowLongArraySyntax.Found"/>

	<!--
	WPCS 3 sniffs and checks that WPCS 2 did not run. Disabled so the effective
	standard stays what it was under WPCS 2; adopting any of them is a separate change.
	-->
	<rule ref="Universal.Operators.DisallowStandalonePostIncrementDecrement">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.ControlStructures.DisallowLonelyIf">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
		<severity>0</severity>
	</rule>
	<rule ref="Universal.Files.SeparateFunctionsFromOO">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Functions.MultiLineFunctionDeclaration.SpaceAfterFunction">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Classes.ClassDeclaration.CloseBraceAfterBody">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Methods.FunctionClosingBrace.SpacingBeforeClose">
		<severity>0</severity>
	</rule>
	<rule ref="PSR2.Files.EndFileNewline">
		<severity>0</severity>
	</rule>
	<rule ref="PSR12.Traits.UseDeclaration">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.CodeAnalysis.RequireExplicitBooleanOperatorPrecedence">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.GetMetaSingle">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.unlink_unlink">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.rename_rename">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_chmod">
		<severity>0</severity>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<severity>0</severity>
	</rule>

	<!--
	Code that predates WPCS 3 and is reported by it only because WPCS 3 renamed the
	error code an existing inline ignore uses, or widened an existing check. Scoped
	to the files concerned so the check stays active everywhere else.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents">
		<exclude-pattern>*/inc/client-logger.php</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.EmptyPHPStatement">
		<exclude-pattern>*/modules/gutenberg/classes/class-spec-block-helper.php</exclude-pattern>
	</rule>
	<rule ref="Universal.Arrays.DuplicateArrayKey">
		<exclude-pattern>*/modules/gutenberg/classes/class-spec-block-config.php</exclude-pattern>
	</rule>
  	<!-- Exclude lib -->
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/lib/*</exclude-pattern>
	<exclude-pattern>*/src/srfm-controls*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/form-builder/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/modules/gutenberg/build/*</exclude-pattern>
	<exclude-pattern>*/modules/gutenberg/node_modules/*</exclude-pattern>
	<exclude-pattern>*/modules/gutenberg/icons/*</exclude-pattern>
</ruleset>
